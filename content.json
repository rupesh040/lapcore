            "cursiveText": "FAQ",
            "headingPart1": "Frequently Asked",
            "headingPart2": "Questions",
            "description": "Find quick answers to common questions about our laptop repair services.",
            "image": "/lapcore/faq.webp",
            "imageAlt": "Open laptop motherboard and repair tools on a workbench",
            "items": [
              {
                "question": "How long does a laptop repair usually take?",
                "answer": "Most common repairs, such as screen or battery replacement, are completed within 1–2 hours. Complex issues like motherboard repair may take longer, depending on diagnosis and part availability."
              },
              {
                "question": "Do you use genuine replacement parts?",
                "answer": "Yes. LAPCORE uses genuine replacement parts for laptop repairs."
              },
              {
                "question": "Is there a warranty on repairs?",
                "answer": "Contact customer support to ask about warranty coverage for your repair."
              },
              {
                "question": "Can you repair all laptop brands?",
                "answer": "Contact customer support with your laptop’s brand and model to check repair availability."
              },
              {
                "question": "Do I need to book an appointment?",
                "answer": "Use the repair request form to share your preferred date. Our team will get in touch to confirm your repair slot."
              }
            ]
          }
        }
